# =====================================================================
# MediLens AI — Production Environment Configuration (.env.production)
# Security Notice: NEVER commit actual production .env files to Git.
# =====================================================================

# Application Mode
ENVIRONMENT=production
DEBUG=False
PORT=8000

# Authentication & Cryptographic Security (SEC-AUTH-002, SEC-SECRET-001)
# Generate via: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_RANDOM_HEX_SECRET_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Database (SEC-AUTHZ-002)
POSTGRES_USER=medilens_admin
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=medilens_production
DATABASE_URL=postgresql+psycopg2://medilens_admin:GENERATE_SECURE_PASSWORD_HERE@db:5432/medilens_production

# Secure Storage & Uploads (SEC-FILE-001..005)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# CORS Allowed Origins
ALLOWED_ORIGINS=https://medilens.yourdomain.com,https://app.medilens.yourdomain.com

# LLM Providers (SEC-AI-001..004)
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY_HERE
OPENAI_API_KEY=

# Rate Limiting Engine (SEC-RATE-001..004)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=100/minute
