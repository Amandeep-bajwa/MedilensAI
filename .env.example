# ==========================================
# MediLens AI - Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
PROJECT_NAME="MediLens AI"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security & Authentication
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY=supersecretkey_change_in_production_medilens_ai_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with fallback SQLite for initial local dev)
# Format: postgresql+psycopg2://user:password@localhost:5432/medilens_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medilens_db
# For lightweight local SQLite testing without local Postgres:
# DATABASE_URL=sqlite:///./database/medilens.db

# Storage / Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# AI & LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional OpenAI / Groq fallback
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database (pgvector / chroma)
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_AI="15/minute"
RATE_LIMIT_UPLOAD="10/minute"
